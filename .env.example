GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PORT=4000

# 文章生成モデル
TEXT_PROVIDER=deepseek
# deepseek / openai / google / anthropic から指定
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
# 品質を揃えたい場合は deepseek-v4-pro に変更できます。
DEEPSEEK_FAST_TEXT_MODEL=deepseek-v4-flash
# 画像プロンプト生成と整合性検査専用。未指定時はDEEPSEEK_TEXT_MODELを使用。
DEEPSEEK_IMAGE_PROMPT_MODEL=deepseek-v4-pro
# 長い創作本文では通常 disabled を推奨。enabled の場合は推論量が増える。
DEEPSEEK_THINKING=disabled
# 日付に関する検索だけはDeepSeek以外の検索対応プロバイダーを利用する。
# WEB_SEARCH_PROVIDER=anthropic
OPENAI_TEXT_MODEL=gpt-5.6-terra
GOOGLE_TEXT_MODEL=gemini-3.6-flash
ANTHROPIC_TEXT_MODEL=claude-sonnet-5

# 料金表示の円換算レート
USD_TO_JPY=160
